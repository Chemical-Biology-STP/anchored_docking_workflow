#!/usr/bin/env python3
"""Wrapper so 'dock' works as a command inside pixi shell."""
import runpy
import sys
import os

sys.path.insert(0, os.path.dirname(os.path.dirname(os.path.abspath(__file__))))
runpy.run_path(os.path.join(os.path.dirname(os.path.dirname(os.path.abspath(__file__))), "generate_slurm.py"), run_name="__main__")
